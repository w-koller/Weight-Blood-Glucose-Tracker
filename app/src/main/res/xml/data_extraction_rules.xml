<?xml version="1.0" encoding="utf-8"?>
<!-- Records and settings are backed up with Android's own backup. The assistant model is large and can be downloaded again, so it is left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
