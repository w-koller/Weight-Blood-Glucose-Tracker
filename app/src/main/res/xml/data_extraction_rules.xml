<?xml version="1.0" encoding="utf-8"?>
<!-- Only records and settings are backed up. The assistant model is large and can be downloaded again, so it is not included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
